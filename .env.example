# Copy to project root as ".env" (gitignored). Loaded only from utils.utils.

# --- Toqan (required) ---
TOQAN_API_KEY=

# Optional; omit to use default in utils/utils.py
TOQAN_BASE_URL=https://api.toqan.ai/api

# --- AWS SES SMTP (required) ---
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional; omit to use defaults in utils/utils.py
SMTP_SERVER=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
